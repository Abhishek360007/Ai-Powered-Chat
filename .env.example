# Copy this file to .env and pick ONE provider below. Never commit .env.

# ---------------------------------------------------------------
# Option 1 (default): Ollama - free, runs locally, no API key needed
# ---------------------------------------------------------------
COMPOSE_PROFILES=ollama
AI_MODEL=llama3.2:3b

# ---------------------------------------------------------------
# Option 2: Groq - free tier, very fast, needs a free key from
# https://console.groq.com/keys
# (remove COMPOSE_PROFILES and AI_MODEL above, then uncomment these)
# ---------------------------------------------------------------
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_your-key-here
# AI_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------
# Option 3: OpenAI - paid
# ---------------------------------------------------------------
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-4o-mini
